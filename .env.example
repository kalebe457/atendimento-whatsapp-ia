# Copie para .env e preencha. Nunca versione o .env (está no .gitignore).

# Servidor HTTP
PORT=3000
# Em produção, só localhost (o Caddy faz o HTTPS na frente). Vazio = todas as interfaces.
HOST=127.0.0.1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario_do_banco
DB_PASSWORD=troque-esta-senha
DB_NAME=atendimento

# WhatsApp (Meta Cloud API)
META_PHONE_NUMBER_ID=000000
META_ACCESS_TOKEN=coloque-o-token-da-meta
META_APP_SECRET=coloque-o-app-secret-da-meta
META_VERIFY_TOKEN=um-texto-qualquer-para-verificar-o-webhook
META_GRAPH_VERSION=v26.0
# false = só registra no log o que seria enviado (o fluxo segue normal)
META_ENVIO_ATIVO=true

# Claude (Anthropic)
ANTHROPIC_API_KEY=coloque-a-chave-da-anthropic

# Telegram (grupo dos vendedores)
TELEGRAM_BOT_TOKEN=000000:coloque-o-token-do-bot
TELEGRAM_CHAT_ID=-1000000000000
TELEGRAM_WEBHOOK_SECRET=um-segredo-longo-e-aleatorio
TELEGRAM_RESUMO_TTL_HORAS=24
